.block-accordion
  .block-accordion__container
    .block-accordion__col--left
      transition-group(name='crossfade', tag='div')
        .block-accordion__content(v-for='content, i in props.content', :key='"content" + i' v-show='active === i')
          h1.block-accordion__title(v-html='content.title')
          .block-accordion__text(v-html='content.text')  
    .block-accordion__col--right
      .block-accordion__tab-container--left
        a.block-accordion__tab(href='#info', v-for='tab, i in props.tabs_left', :key='i' @click='toggleSection(i)' v-html='tab.label')
      .block-accordion__tab-container--right
        a.block-accordion__tab(href='#info', v-for='tab, j in props.tabs_right', :key='j' @click='toggleSection(j + props.tabs_left.length)' v-html='tab.label')
        .test(v-if='width', id='info')