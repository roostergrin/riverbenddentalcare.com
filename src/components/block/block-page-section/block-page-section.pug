.block-page-section
  section.block-page-section__section(v-for='section, i in props', :key='i', :class="{ 'block-page-section__section--alt': i % 2 !== 0 }")
    .block-page-section__image(:style="{ backgroundImage: 'url(' + section.image + ')' }")
      img.sr-only(:src='section.image', :alt='section.title')
    .block-page-section__container
      .block-page-section__content
        h2.block-page-section__title(v-html='section.title')
        .block-page-section__text(v-html='section.text')
        .block-page-section__link
          router-link(:to='section.link') Learn More
          AppIcon.block-page-section__icon(name='arrow')
        
