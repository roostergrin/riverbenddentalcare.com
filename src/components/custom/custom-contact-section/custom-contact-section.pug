.custom-contact-section
  section.custom-contact-section__section
    iframe.custom-contact-section__frame(:src='props.map')
    .custom-contact-section__info-container
      .custom-contact-section__information
        p  
          a(:href='contact.address.address_href', v-html='contact.address.address_text')
        p Phone: 
          a(:href='contact.phone.phone_link', v-html='contact.phone.phone_number')
        p Fax: 
          strong(v-html='contact.fax')
        p Email: 
          a(:href='contact.email.link', v-html='contact.email.text')
        .custom-contact-section__hours 
          .custom-contact-section__hours--title Hours: 
          p MON: 9:00 - 4:00PM
          p TUE: 9:00 - 4:00 PM
          p WED: 12:00 - 8:00 PM
          p THU: 9:00 - 4:00PM
          p FRI : 7:30 - 1:00 PM
          p SAT : ONCE PER MONTH 9:00 - 2:00 PM 
  .custom-contact-section__container
    .custom-contact-section__content
      h1.custom-contact-section__title(v-html='props.title')
      .custom-contact-section__text(v-html='props.text')
      .custom-contact-section__form-container
        ContactForm  