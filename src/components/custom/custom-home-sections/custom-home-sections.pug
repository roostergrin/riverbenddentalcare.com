.custom-home-sections
  section.custom-home-sections__section(v-for='section, i in props', :key='i', :class="{ 'custom-home-sections__section--alt': i % 2 !== 0 }")
    .custom-home-sections__image(:style="{ backgroundImage: 'url(' + section.image + ')' }")
      img.sr-only(:src='section.image', :alt='section.title')
    .custom-home-sections__container
      .custom-home-sections__content
        .custom-home-sections__title(v-html='section.title')
        .custom-home-sections__text(v-html='section.text')
        .custom-home-sections__link
          router-link(:to='section.link') Learn More
          AppIcon.custom-home-sections__icon(name='arrow')
        
