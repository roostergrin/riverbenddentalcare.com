.hero-pages
  .hero-pages__overlay
  .hero-pages__bg(:style="{ backgroundImage: 'url(' + props.image + ')' }")
  .hero-pages__container  
    .hero-pages__title(v-html='props.title', :class="{ 'hero-pages__title--left': titlePos === 'left', 'hero-pages__title--right': titlePos === 'right', 'hero-pages__title--center': titlePos === 'center'}")
