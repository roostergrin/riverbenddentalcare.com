.slider-main__wrapper
  .slider-main__section(v-for='slide, i in props', :key='i', :class="{ 'slider-main__section--first': i === 0 && activeSlide === (props.length - 1), 'slider-main__section--scrolled': activeSlide > i, 'slider-main__section--not-scrolled': activeSlide < i, 'slider-main__section--active': activeSlide === i, 'slider-main__section--last': i === (props.length - 1) && lastSlide }")
    .slider-main__image(:style="{ backgroundImage: 'url(' + slide.image + ')' }")
      
  .slider-main__pagination
    .slider-main__indicator(v-for='dot, i in slides', :key='i', :class="{ 'slider-main__indicator--active': activeSlide === i }" @click='goToSlide(i)')
